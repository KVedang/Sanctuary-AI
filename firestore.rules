rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-by-default for unlisted root documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Root user document (Profile & Settings)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update, delete: if isOwner(userId) && isValidId(userId);

      // Journals subcollection
      match /journals/{journalId} {
        allow get, delete: if isOwner(userId) && isValidId(journalId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(journalId)
          && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(journalId)
          && request.resource.data.userId == userId;
      }

      // Conversations subcollection
      match /conversations/{conversationId} {
        allow get, delete: if isOwner(userId) && isValidId(conversationId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(conversationId)
          && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(conversationId)
          && request.resource.data.userId == userId;

        // Messages subcollection
        match /messages/{messageId} {
          allow get, delete: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(conversationId);
          allow create, update: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
        }
      }

      // Goals subcollection
      match /goals/{goalId} {
        allow get, delete: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(goalId)
          && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(goalId)
          && request.resource.data.userId == userId;
      }

      // Insights subcollection
      match /insights/{insightId} {
        allow get, delete: if isOwner(userId) && isValidId(insightId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(insightId)
          && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(insightId)
          && request.resource.data.userId == userId;
      }

      // Rate limit & usage telemetry subcollection
      match /usage/{usageId} {
        allow read, write: if isOwner(userId) && isValidId(usageId);
      }
    }
  }
}
